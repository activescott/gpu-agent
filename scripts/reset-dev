#!/usr/bin/env bash
this_dir=$(cd $(dirname "$0"); pwd) # this script's directory
this_script=$(basename $0)
workspace_root=$(cd "$this_dir/.."; pwd)

#-e: Exits immediately if any command returns a non-zero status (i.e., fails)
#-u: Treats unset variables as errors and exits immediately
#-o pipefail: If any command in a pipeline fails, the entire pipeline fails
set -euo pipefail

help () {
  echo
  cat << END_DOC
USAGE: $this_script [OPTIONS]

Completely resets the GPUPoet development environment.

WARNING: This is a DESTRUCTIVE operation that will:
   - Delete the gpupoet-dev namespace and all resources
   - Remove gpu-poet's persistent volumes and database data
   - Clear any cached gpu-poet Docker images

This does NOT delete the shared 'kind' cluster — it's shared with other
local projects (fernfiles, ramblefeed, tinkerbell). To recreate the cluster
itself (e.g. to pick up a new port mapping), see k8s/kind-cluster.yaml.

This cannot be undone!

Options:
  -f, --force   Skip confirmation prompt
  -h, --help    Show this help message

END_DOC
}

die () {
    echo "*** ERROR ***"
    echo >&2 "ERROR: $@"
    help
    exit 1
}

confirm_reset() {
    echo "WARNING: This will completely reset your development environment!"
    echo ""
    echo "This will:"
    echo "  - Delete the gpupoet-dev namespace and all resources"
    echo "  - Remove gpu-poet's persistent volumes and database data"
    echo "  - Clear cached gpu-poet Docker images"
    echo ""
    echo "The shared 'kind' cluster itself is NOT deleted (other local"
    echo "projects share it)."
    echo ""
    echo "This operation CANNOT be undone!"
    echo ""
    read -p "Are you sure you want to continue? Type 'yes' to confirm: " -r
    if [[ ! $REPLY =~ ^yes$ ]]; then
        echo "Reset cancelled."
        exit 0
    fi
}

reset_development() {
    echo "=== Resetting GPUPoet Development Environment ==="

    # Delete only gpu-poet's own namespace on the shared kind cluster — never
    # the cluster itself, which other local projects (fernfiles, ramblefeed,
    # tinkerbell) also depend on.
    if command -v kubectl &> /dev/null; then
        echo "Deleting gpupoet-dev namespace on the shared kind cluster..."
        kubectl --context kind-kind delete namespace gpupoet-dev --ignore-not-found=true || true
    fi

    # Clean up Docker images if Docker is available
    if command -v docker &> /dev/null; then
        echo "Cleaning up gpupoet Docker images..."
        docker rmi gpupoet-dev:latest 2>/dev/null || true
        docker rmi $(docker images -q --filter "reference=gpupoet*") 2>/dev/null || true
    fi

    echo ""
    echo "Development environment reset complete!"
    echo ""
    echo "To start fresh, run: ./scripts/dev"
}

# Parse arguments
force=false
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--force)
            force=true
            shift
            ;;
        -h|--help)
            help
            exit 0
            ;;
        *)
            die "Unknown option: $1"
            ;;
    esac
done

cd "$workspace_root"

if [[ "$force" != "true" ]]; then
    confirm_reset
fi

reset_development
