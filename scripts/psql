#!/bin/bash
# Query local dev PostgreSQL database
# Usage: ./scripts/psql 'SELECT * FROM "Listing" LIMIT 10;'
#        ./scripts/psql   (interactive mode)

set -e

if ! kubectl --context kind-kind cluster-info &> /dev/null; then
    echo "Error: kind cluster not reachable on context kind-kind. Start it with: ./scripts/dev"
    exit 1
fi

if [ -z "$1" ]; then
    # Interactive mode
    kubectl --context kind-kind exec -it -n gpupoet-dev db-0 -- \
        psql -U gpu_agent -d gpu_agent
else
    # Query mode
    kubectl --context kind-kind exec -it -n gpupoet-dev db-0 -- \
        psql -U gpu_agent -d gpu_agent -c "$1"
fi
